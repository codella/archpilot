#!/usr/bin/env bash
# Generated release installer. Run with bash (including curl ... | bash).
set -euo pipefail

VERSION=@VERSION@
RELEASE_BASE=@RELEASE_BASE@
WHEEL=@WHEEL@
WHEEL_SHA256=@WHEEL_SHA256@
release_source=''
auto_start=true
prefix="${XDG_DATA_HOME:-$HOME/.local/share}/archpilot"
bin_dir="$HOME/.local/bin"
if [[ $(id -u) == 0 ]]; then
    prefix=/opt/archpilot
    bin_dir=/usr/local/bin
fi
usage() {
    cat <<'EOF'
Archpilot bootstrap
  --base-url URL  HTTPS directory containing the release wheel
  --release-dir DIR  Use a local release directory (for VM testing)
  --prefix DIR    Installation directory (default: /opt/archpilot for root)
  --bin-dir DIR   Launcher directory (default: /usr/local/bin for root)
  --help         Show this help
  --no-start     Install without opening the assistant
Installs and opens Archpilot; it handles sign-in automatically.
EOF
}
fail() { printf 'Archpilot: %s\n' "$*" >&2; exit 1; }
while (($#)); do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --no-start) auto_start=false; shift ;;
        --base-url|--release-dir|--prefix|--bin-dir)
            (($# >= 2)) || fail "Missing value for $1"
            case "$1" in
                --base-url) RELEASE_BASE=$2 ;;
                --release-dir) release_source=$2 ;;
                --prefix) prefix=$2 ;;
                --bin-dir) bin_dir=$2 ;;
            esac
            shift 2 ;;
        *) fail "Unknown option: $1" ;;
    esac
done
if [[ -n $release_source ]]; then
    [[ $release_source == /* && -d $release_source ]] || fail '--release-dir must be an existing absolute directory.'
else
    [[ $RELEASE_BASE == https://* ]] || fail 'A release HTTPS URL is required (--base-url).'
    command -v curl >/dev/null || fail 'curl is required.'
fi
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || fail 'This release supports Linux x86_64.'
[[ $prefix == /* && $bin_dir == /* ]] || fail 'Installation directories must be absolute paths.'
[[ $prefix != *$'\n'* && $bin_dir != *$'\n'* ]] || fail 'Invalid installation directory.'
command -v sha256sum >/dev/null || fail 'sha256sum is required.'

# Only provision system prerequisites automatically inside the Arch live ISO.
if ! command -v python3 >/dev/null || ! python3 -c 'import venv, ensurepip' 2>/dev/null; then
    [[ $(id -u) == 0 && -d /run/archiso ]] || fail 'Install Python 3.11+ with venv/pip support, then retry.'
    command -v pacman >/dev/null || fail 'pacman is required to provision live-ISO prerequisites.'
    printf 'Installing Python prerequisites in the live environment…\n'
    pacman -Syu --needed --noconfirm python python-pip
fi
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || fail 'Python 3.11+ is required.'

mkdir -p "$prefix/releases" "$bin_dir"
# Unique permanent path: venv launchers contain absolute interpreter paths.
# Never rename a virtual environment after installing into it.
release_dir=$(mktemp -d "$prefix/releases/$VERSION.XXXXXXXX")
download_dir=$(mktemp -d)
committed=false
cleanup() {
    rm -rf -- "$download_dir"
    if [[ $committed != true ]]; then rm -rf -- "$release_dir"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -n $release_source ]]; then
    printf 'Using local Archpilot %s release…\n' "$VERSION"
    cp -- "$release_source/$WHEEL" "$download_dir/$WHEEL"
else
    printf 'Downloading Archpilot %s…\n' "$VERSION"
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 15 --max-time 180 --retry 2 \
        "$RELEASE_BASE/$WHEEL" -o "$download_dir/$WHEEL"
fi
printf '%s  %s\n' "$WHEEL_SHA256" "$download_dir/$WHEEL" | sha256sum --check --status \
    || fail 'Release checksum mismatch; installation stopped.'
python3 -m venv "$release_dir"
"$release_dir/bin/python" -m pip install --disable-pip-version-check --no-input "$download_dir/$WHEEL"
"$release_dir/bin/archpilot" --help >/dev/null

# Refuse to replace an unrelated command; repeat installs replace only our symlink.
launcher="$bin_dir/archpilot"
if [[ -e $launcher || -L $launcher ]]; then
    [[ -L $launcher ]] || fail "$launcher exists and is not an Archpilot symlink."
    old_target=$(readlink "$launcher")
    [[ $old_target == "$prefix/releases/"*/bin/archpilot ]] || fail "$launcher points outside this installation."
fi
# A temporary symlink followed by rename avoids a partially written launcher.
link_dir=$(mktemp -d "$bin_dir/.archpilot-link.XXXXXXXX")
ln -s "$release_dir/bin/archpilot" "$link_dir/archpilot"
mv -Tf "$link_dir/archpilot" "$launcher"
rmdir "$link_dir"
committed=true
printf '\nArchpilot %s installed.\n\n' "$VERSION"
printf 'Start Archpilot:\n  %q\n\n' "$launcher"
printf 'Offline demo:\n  %q demo\n' "$launcher"
printf '\nOn a standard Arch live ISO, this installation disappears after reboot.\n'

# curl | bash owns stdin until the download ends. Open the controlling terminal
# explicitly so the assistant's prompts work after a piped installation.
if [[ $auto_start == true ]]; then
    if ( : </dev/tty ) 2>/dev/null; then
        cleanup
        trap - EXIT INT TERM
        exec "$launcher" </dev/tty >/dev/tty 2>&1
    else
        printf '\nNo interactive terminal available. Run the command above to start.\n'
    fi
fi
